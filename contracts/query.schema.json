{
  "$defs": {
    "Filter": {
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "operator": {
          "default": "eq",
          "enum": [
            "eq",
            "ne",
            "gt",
            "gte",
            "lt",
            "lte",
            "contains",
            "startswith",
            "endswith",
            "in",
            "between",
            "is_null",
            "not_null"
          ],
          "title": "Operator",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "field"
      ],
      "title": "Filter",
      "type": "object"
    },
    "SortSpec": {
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "direction": {
          "default": "asc",
          "enum": [
            "asc",
            "desc"
          ],
          "title": "Direction",
          "type": "string"
        }
      },
      "required": [
        "field"
      ],
      "title": "SortSpec",
      "type": "object"
    }
  },
  "properties": {
    "filters": {
      "items": {
        "$ref": "#/$defs/Filter"
      },
      "title": "Filters",
      "type": "array"
    },
    "filter_logic": {
      "default": "and",
      "enum": [
        "and",
        "or"
      ],
      "title": "Filter Logic",
      "type": "string"
    },
    "sort": {
      "items": {
        "$ref": "#/$defs/SortSpec"
      },
      "title": "Sort",
      "type": "array"
    },
    "limit": {
      "default": 50,
      "maximum": 1000,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    },
    "offset": {
      "default": 0,
      "minimum": 0,
      "title": "Offset",
      "type": "integer"
    },
    "include_deleted": {
      "default": false,
      "title": "Include Deleted",
      "type": "boolean"
    },
    "expand": {
      "default": true,
      "title": "Expand",
      "type": "boolean"
    }
  },
  "title": "zooagent query",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
